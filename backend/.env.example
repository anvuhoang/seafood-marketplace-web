DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/seafood-marketplace-dev?schema=public"
PORT=5000
# Allowed browser origins, comma separated. Add the admin site too, e.g.
#   FRONTEND_URL=http://localhost:3000,http://admin.localhost:3000
FRONTEND_URL=http://localhost:3000

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Admin sessions are kept short.
ADMIN_JWT_EXPIRES_IN=2h

# Smart Import: vendors describe a product (typed or spoken) and get an editable draft.
# Get a key at https://console.groq.com and keep it here only; never in the frontend.
# Leave empty to switch the feature off, or set SMART_IMPORT_PROVIDER=mock to try it without a key.
GROQ_API_KEY=
# SMART_IMPORT_PROVIDER=groq
# SMART_IMPORT_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# SMART_IMPORT_EXTRACT_MODEL=openai/gpt-oss-120b
# SMART_IMPORT_TIMEOUT_MS=20000

# PayOS QR payment (https://payos.vn): keep these keys here only; never in the frontend.
# Leave empty to switch QR payment off. Register <public API url>/api/payments/payos/webhook
# as the webhook in the PayOS dashboard (a tunnel such as ngrok works for local tests).
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# PAYOS_LINK_TTL_MINUTES=15

# Email (password reset, order and payment notices). Gmail SMTP:
#   1. Turn on 2-Step Verification for the Gmail account.
#   2. Create an App password at https://myaccount.google.com/apppasswords (16 characters).
#   3. Put the address in SMTP_USER and the app password in SMTP_PASS (never the real Gmail password).
# Leave SMTP_USER empty and mails are written to the API log instead of being sent (handy while developing).
# MAIL_PROVIDER=off sends and logs nothing. Gmail allows about 500 mails a day.
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM="HaiSan Express" <your.address@gmail.com>
# The website address used in the links inside mails (defaults to the first FRONTEND_URL).
# APP_URL=http://localhost:3000
# PASSWORD_RESET_TTL_MINUTES=30

# Sign in with Google. Create an "OAuth client ID" of type Web application at
# https://console.cloud.google.com/apis/credentials and add the website address
# (e.g. http://localhost:3000) under "Authorized JavaScript origins". Only the client ID is needed.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Chatbot (shopping assistant): needs a key from https://aistudio.google.com/apikey, kept here only.
# Leave empty to switch the chatbot off, or set CHAT_PROVIDER=mock to try it without a key.
# CHATBOT_ENABLED=false turns it off whatever else is set.
GEMINI_API_KEY=
# CHAT_PROVIDER=gemini
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768
# CHAT_RATE_LIMIT_MESSAGES=20
# CHAT_RATE_LIMIT_WINDOW_MINUTES=10
# CHAT_MAX_MESSAGE_LENGTH=500
# CHAT_MAX_OUTPUT_TOKENS=1500
# After editing backend/knowledge/*.md run: npm run knowledge:ingest

# Product search with Elasticsearch (typos, no accents needed, best match first, suggestions while typing).
# Empty = the shop searches in memory as before. Run one with: docker compose up elasticsearch
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=haisan-products
# After a restore of the database, rebuild the index with: npm run search:reindex

# Checkout: flat shipping fee in VND charged once for every vendor in an order (default 30000).
# SHIPPING_FEE_PER_VENDOR=30000

# Visual Search: customers upload a photo and get matching products. Uses GROQ_API_KEY above.
# On ('groq') when the key is set, otherwise off; set VISUAL_SEARCH_PROVIDER=off to switch it off.
# The model must accept images (see https://console.groq.com/docs/vision).
# VISUAL_SEARCH_PROVIDER=groq
# VISUAL_SEARCH_MODEL=qwen/qwen3.8-27b
# VISUAL_SEARCH_TIMEOUT_MS=20000

# Review and store photos (Cloudinary, https://cloudinary.com). Leave empty to switch uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared state: rate limits and the cache. Empty = kept in this process's memory (right for ONE API process).
# With several processes behind a load balancer set it, so they share one set: docker compose up redis
# REDIS_URL=redis://localhost:6379
# REDIS_KEY_PREFIX=haisan:
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=300
# RATE_LIMIT_WINDOW_SECONDS=60
# CACHE_ENABLED=true
# CACHE_CATALOG_TTL_SECONDS=30
# Number of proxies in front of the API (1 behind nginx), so request.ip is the visitor and not the proxy.
# TRUST_PROXY=1
# RATE_LIMIT_TRUST_INTERNAL=false
# Swagger UI at /api/docs: on outside production unless set.
# API_DOCS_ENABLED=true
