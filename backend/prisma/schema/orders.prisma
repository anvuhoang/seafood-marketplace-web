model Order {
  id              String      @id @default(uuid()) @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(40)
  userId          String      @map("user_id") @db.Uuid
  addressId       String?     @map("address_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @db.Decimal(14, 2)
  shippingTotal   Decimal     @default(0) @map("shipping_total") @db.Decimal(14, 2)
  grandTotal      Decimal     @map("grand_total") @db.Decimal(14, 2)
  recipientName   String      @map("recipient_name") @db.VarChar(150)
  recipientPhone  String      @map("recipient_phone") @db.VarChar(30)
  shippingAddress String      @map("shipping_address") @db.VarChar(500)
  shippingProvince String     @map("shipping_province") @db.VarChar(100)
  shippingDistrict String     @map("shipping_district") @db.VarChar(100)
  shippingWard   String?      @map("shipping_ward") @db.VarChar(100)
  customerNote   String?      @map("customer_note") @db.Text
  /// Sent by the browser with the order, so a repeated request returns this order instead of creating another.
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  address      UserAddress?  @relation(fields: [addressId], references: [id], onDelete: SetNull)
  vendorOrders VendorOrder[]
  payment      Payment?

  /// A customer can reuse a key only for the same order; orders without a key (older ones) do not clash.
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model VendorOrder {
  id            String            @id @default(uuid()) @db.Uuid
  orderId       String            @map("order_id") @db.Uuid
  vendorId      String            @map("vendor_id") @db.Uuid
  status        VendorOrderStatus @default(PENDING)
  subtotal      Decimal           @db.Decimal(14, 2)
  shippingFee   Decimal           @default(0) @map("shipping_fee") @db.Decimal(14, 2)
  grandTotal    Decimal           @map("grand_total") @db.Decimal(14, 2)
  vendorNote    String?           @map("vendor_note") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  vendor Vendor     @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items OrderItem[]
  shipment Shipment?

  @@unique([orderId, vendorId])
  @@index([vendorId, status, createdAt])
  @@map("vendor_orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  vendorOrderId       String   @map("vendor_order_id") @db.Uuid
  offerId             String   @map("offer_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(220)
  variantNameSnapshot String   @map("variant_name_snapshot") @db.VarChar(180)
  vendorNameSnapshot  String   @map("vendor_name_snapshot") @db.VarChar(180)
  unitSnapshot        String   @map("unit_snapshot") @db.VarChar(30)
  unitPrice           Decimal  @map("unit_price") @db.Decimal(14, 2)
  quantity            Decimal  @db.Decimal(12, 3)
  lineTotal           Decimal  @map("line_total") @db.Decimal(14, 2)

  vendorOrder VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Restrict)
  offer       VendorOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)
  review      Review?

  @@index([vendorOrderId])
  @@map("order_items")
}
