model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([userId])
  @@map("carts")
}

model CartItem {
  id        String      @id @default(uuid()) @db.Uuid
  cartId    String      @map("cart_id") @db.Uuid
  offerId   String      @map("offer_id") @db.Uuid
  quantity  Decimal     @db.Decimal(12, 3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart  Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  offer VendorOffer @relation(fields: [offerId], references: [id], onDelete: Restrict)

  @@unique([cartId, offerId])
  /// The unique key above starts with cartId, so it cannot find the carts that hold one offer (the vendor's
  /// product editor counts them before an offer may be removed).
  @@index([offerId])
  @@map("cart_items")
}
