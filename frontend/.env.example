# Copy to .env.local. Nothing here is secret: NEXT_PUBLIC_ values are visible in the browser.

# Where the API listens.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Address of the admin site. When set, /admin is served only on this host and the
# shop host redirects /admin to it. Leave it out to keep /admin on the same host.
# *.localhost resolves to your own machine in Chrome, Edge and Firefox, so no hosts file is needed.
# Also add this origin to FRONTEND_URL in backend/.env so the API accepts it.
NEXT_PUBLIC_ADMIN_URL=http://admin.localhost:3000
