# Settings of the shop on a server. Copy this file to /opt/haisan/.env on the server and fill it in.
# It holds secrets: it stays on the server and is never committed.

# --- Where the shop is -------------------------------------------------------------------------------------------
# The DNS name of the server (no https://, no slash). Caddy gets a certificate for it.
DOMAIN=haisan.eastasia.cloudapp.azure.com
# The same address as the visitor types it. The API allows browsers from here and the links in mails lead here.
PUBLIC_URL=https://haisan.eastasia.cloudapp.azure.com

# --- Images (built by GitHub, see .github/workflows/docker-publish.yml) -------------------------------------------
# Lower case: ghcr.io/<owner>/<repository>-api and -web. Use a release tag instead of latest to pin a version.
API_IMAGE=ghcr.io/anvuhoang/seafood-marketplace-web-api:latest
WEB_IMAGE=ghcr.io/anvuhoang/seafood-marketplace-web-web:latest

# --- Database and security ---------------------------------------------------------------------------------------
# Any long password; it is only used between the containers.
POSTGRES_PASSWORD=
# At least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# nginx is reached through Caddy only, so its own port stays closed.
HTTP_PORT=127.0.0.1:8088

# --- Optional features (leave empty to switch them off) -----------------------------------------------------------
# Mail: a Gmail address and its App password. Empty = mails are written to the API log.
SMTP_USER=
SMTP_PASS=
# Sign in with Google: the OAuth client ID. Add PUBLIC_URL to its "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=
# Chatbot, QR payment, photos, Smart Import: see .env.docker.example for what each key does.
GEMINI_API_KEY=
CHAT_PROVIDER=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GROQ_API_KEY=
