# Settings for `docker compose up`. Copy this file to `.env` (next to docker-compose.yml) and fill it in.
# `.env` is not committed: it holds secrets.

# Database. Pick any password; it is only used between the containers.
POSTGRES_PASSWORD=
# POSTGRES_USER=haisan
# POSTGRES_DB=haisan

# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The address visitors use. It is written into the website when it is built (so rebuild after changing it:
# `docker compose up --build`) and is the origin the API allows. For a real server use https://your-domain.
# PUBLIC_URL=http://localhost:8088
# HTTP_PORT=8088   # not 8080: Windows reserves it on many machines

# Optional features; leave empty to switch them off.
# Chatbot: a key from https://aistudio.google.com/apikey, or CHAT_PROVIDER=mock to try it without a key.
GEMINI_API_KEY=
# CHAT_PROVIDER=
# PayOS QR payment
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Email: a Gmail address and its App password (see backend/.env.example); empty = mails go to the API log
SMTP_USER=
SMTP_PASS=
# Sign in with Google: the OAuth client ID (add PUBLIC_URL to its authorized JavaScript origins)
GOOGLE_CLIENT_ID=
# Review and store photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Smart Import for vendors
GROQ_API_KEY=
